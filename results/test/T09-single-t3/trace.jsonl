e":"notification-service","category":"infrastructure_failure","trigger":null},"mechanism":"The 1 GiB memory limit is insufficient for current workload even without a leak.","supporting":["F4"],"contradicting":["F9","F8"],"assumptions":["A4"],"predictions":[],"confidence":0.03}],"gaps":[{"tool":"query_logs","scope":"heap dump / detailed GC logs","reason":"Tool cannot retrieve heap dumps; needed to confirm cache domination."},{"tool":"query_metrics","scope":"cache size metric (e.g., template_cache_entries)","reason":"Metric not emitted; would directly show unbounded growth."},{"tool":"get_change_history","scope":"Kafka consumer config (max.poll.records, fetch.max.bytes)","reason":"No record of consumer config changes; needed to rule out H3."}],"actions":[{"kind":"mitigate","description":"Rollback notification-service to v3.9.1 or disable the new per‑locale cache via feature flag.","rationale":"Stops further memory growth immediately; the deploy is the only recent change.","hypothesis_id":"H1","urgency":"now"},{"kind":"mitigate","description":"Temporarily raise pod memory limit to 2 GiB and add restart‑rate alert.","rationale":"Provides breathing room while the fix is validated; prevents immediate OOMKill cascades.","hypothesis_id":"H1","urgency":"now"},{"kind":"fix","description":"Implement bounded cache (LRU/TTL, max entries) and ship hot‑fix v3.9.3.","rationale":"Eliminates the unbounded growth root cause.","hypothesis_id":"H1","urgency":"soon"},{"kind":"prevent","description":"Add cache‑size metric (template_cache_entries) and GC pause time metric.","rationale":"Provides observability for future regressions.","hypothesis_id":"H1","urgency":"later"},{"kind":"investigate","description":"Obtain heap dump from a restarted pod to confirm cache objects dominate retained heap.","rationale":"Closes Gap G1 and validates hypothesis H1.","hypothesis_id":"H1","urgency":"soon"}],"open_questions":["How many distinct locales were seen during the incident?","Does the new cache hav